# Optional: docker-compose.yml already has defaults for local use.
# Copy to .env only if you want to override a value.

POSTGRES_USER=celsius
POSTGRES_PASSWORD=change-me
POSTGRES_DB=celsius360
DB_PORT=5434

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Ingestion: packets per second (0 = unlimited), batch size and full reprocessing.
INGEST_PACKETS_PER_SECOND=2000
INGEST_BATCH_SIZE=500
INGEST_FROM_START=false

BACKEND_PORT=3000
FRONTEND_PORT=8080
